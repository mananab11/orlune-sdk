{
  "name": "orlune-sdk",
  "version": "0.2.0",
  "description": "AI usage telemetry and runtime guardrails for OpenAI and Anthropic clients.",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test:package": "node scripts/check-package.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "openai": "^7.8.0",
    "typescript": "^5.6.2"
  },
  "keywords": [
    "analytics",
    "ai",
    "openai",
    "sdk"
  ],
  "author": "",
  "license": "MIT"
}
